# ESP32-S3 N16R8 (16MB flash + 8MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash: **effective mode is QIO @ 80 MHz**. The shipped image headers carry DIO (mode 0x02)
# because CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=y builds DIO images and lets the 2nd-stage
# bootloader upgrade to QIO at runtime (boot log: "spi_flash: flash io: qio"; the flash is
# quad-capable, eFuse FLASH_TYPE = 4 data lines, and PSRAM is octal — standard N16R8 setup).
# AUTO_DETECT is kept ON to preserve exactly that behavior. To pin it, set
# CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=n and choose FLASHMODE_QIO explicitly.
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# A real task-watchdog hang should reboot the device instead of leaving a
# frozen screen. The ui_monitor_task handles LVGL-task stalls separately.
CONFIG_ESP_TASK_WDT_PANIC=y

# The radio decodes MP3 in software while LVGL software-rotates the 480x320
# framebuffer; -Og leaves too little CPU headroom. -O2 keeps the audio path
# stable without changing any functional configuration.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
# clock_ui.c uses lv_font_montserrat_48 for the big clock digits and 14/24 for the rest;
# all three must be enabled or a clean build fails to link.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# LVGL 9 allocator: use the system heap (malloc) instead of a fixed 64 KB
# static pool. The pool wasted internal RAM that the AAC decoder needs, and
# the UI only used ~40% of it.
CONFIG_LV_USE_STDLIB_MALLOC=2
CONFIG_LV_USE_PERF_MONITOR=n

# Bluetooth is unused by the clock/radio app. Disabling it frees internal RAM
# (the HTTPS radio streams need mbedTLS working buffers) and flash.
CONFIG_BT_ENABLED=n

# Allocate mbedTLS buffers in PSRAM. The radio streams are public, so the
# "internal RAM only" recommendation does not apply and 8 MB PSRAM is idle.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# esp_audio_codec: only what we actually use (AAC + MP3 decode, TS container).
# Everything else is dead weight in the binary.
CONFIG_AUDIO_ENCODER_AAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_G711_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_ENCODER_OPUS_SUPPORT=n
CONFIG_AUDIO_ENCODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_ALAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_PCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_SBC_SUPPORT=n
CONFIG_AUDIO_ENCODER_LC3_SUPPORT=n
CONFIG_AUDIO_ENCODER_G722_SUPPORT=n
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_FLAC_SUPPORT=n
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=n
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=n
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_PCM_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_WAV_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_M4A_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=n
# AAC + MP3 decoders and the TS container stay enabled (defaults y).

# Big built-in CJK font (~154 KB bitmaps) used as the fallback for TV channel
# names coming from the runtime IPTV playlist -- those glyphs are not in the
# generated subsets.
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
