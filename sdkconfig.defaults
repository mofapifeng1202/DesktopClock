# ESP32-S3 N16R8 (16MB flash + 8MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash: **effective mode is QIO @ 80 MHz**. The shipped image headers carry DIO (mode 0x02)
# because CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=y builds DIO images and lets the 2nd-stage
# bootloader upgrade to QIO at runtime (boot log: "spi_flash: flash io: qio"; the flash is
# quad-capable, eFuse FLASH_TYPE = 4 data lines, and PSRAM is octal — standard N16R8 setup).
# AUTO_DETECT is kept ON to preserve exactly that behavior. To pin it, set
# CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=n and choose FLASHMODE_QIO explicitly.
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The radio decodes MP3 in software while LVGL software-rotates the 480x320
# framebuffer; -Og leaves too little CPU headroom. -O2 keeps the audio path
# stable without changing any functional configuration.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
# clock_ui.c uses lv_font_montserrat_48 for the big clock digits and 14/24 for the rest;
# all three must be enabled or a clean build fails to link.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# LVGL 9 uses LV_USE_STDLIB_MALLOC (0 = built-in allocator). The LVGL 8 symbol
# CONFIG_LV_MEM_CUSTOM no longer exists and is ignored by the build system.
CONFIG_LV_USE_STDLIB_MALLOC=0
CONFIG_LV_USE_PERF_MONITOR=n

# Bluetooth (ESP32-S3 supports BLE only)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
